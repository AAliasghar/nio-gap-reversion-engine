# Copy to .env and change the passwords. docker compose reads .env automatically.

# Trading warehouse (Postgres). NIO_DB_HOST=localhost is for running scripts
# on your machine; inside Docker, docker-compose.yml sets nio_postgres instead.
NIO_DB_HOST=localhost
NIO_DB_PORT=5432
NIO_DB_NAME=trading_warehouse
NIO_DB_USER=quant_user
NIO_DB_PASSWORD=quant_password

# Airflow metadata database
AIRFLOW_DB_HOST=airflow_db
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow

# Airflow web UI
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me
